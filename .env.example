# ═══ Datastier ═══
DATA_STI=./data
MODELLER_STI=./modeller
INNTAK_STI=./data/inntak
BEHANDLET_STI=./data/behandlet
GJENNOMGANG_STI=./data/gjennomgang
FINJUSTERING_STI=./data/finjustering
LOGGER_STI=./data/logger

# ═══ GPU ═══
GPU_ENHET=cuda:0
GPU_MINNE_UTNYTTELSE=0.85

# ═══ Konfidens-terskel ═══
# Prosent (0–100). Sider under terskelen sendes til menneskelig gjennomgang.
KONFIDENS_TERSKEL=85

# ═══ Tjenesteporter ═══
OCR_PORT=8001
NLP_PORT=8002
SOK_PORT=8003
API_PORT=8000
DASHBOARD_PORT=5000
MILVUS_PORT=19530

# ═══ Milvus ═══
MILVUS_VERT=milvus
MILVUS_SAMLING=nav_dokumenter

# ═══ API-autentisering ═══
# Sett til en sterk tilfeldig streng i produksjon. Tom = ingen autentisering (utvikling).
API_NOKKEL=nav-secret-2026

# ═══ Redis (jobbkø og statussporing) ═══
REDIS_URL=redis://redis:6379/0
# Maks antall PDF-filer som behandles parallelt (forhindrer GPU OOM)
MAKS_OCR_JOBBER=2

# ═══ Label Studio ═══
LABEL_STUDIO_PORT=8080
LABEL_STUDIO_API_KEY=nav-secret-2026
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_OCR_PROSJEKT_ID=1

# ═══ Finjustering ═══
# Antall dager mellom automatiske finjusteringskjøringer
FINJUSTERING_INTERVALL_DAGER=90
# Minimum antall korreksjoner før finjustering trigges
MIN_KORREKSJONER_FOR_FINJUSTERING=500

# ═══ Model serving (valgfritt — docs/SIKKERHETSKOPI.md-stil, se README) ═══
# Sett LLM_URL for å bruke ekstern Borealis-servering (vLLM-profilen):
#   docker compose --profile llm up -d llm
#   LLM_URL=http://llm:8000/v1
# Tom = workeren laster Borealis lokalt (4-bit) som før.
LLM_URL=
LLM_MODELL=borealis
# Andel av GPU-minnet vLLM får reservere (deler GPU med nlp_worker lokalt)
LLM_GPU_ANDEL=0.60

# ═══ Sikkerhetskopi ═══
BACKUP_INTERVALL_TIMER=24
BACKUP_DAGLIGE=7
BACKUP_UKENTLIGE=4
BACKUP_MAANEDLIGE=6

# ═══ Oppbevaring (NAV: dokumenter maks 6 måneder — docs/OPPBEVARING.md) ═══
# Budsjett: OPPBEVARING_MAKS_DAGER + eldste backup-kopi <= 180 dager
OPPBEVARING_MAKS_DAGER=150
OPPBEVARING_INTERVALL_TIMER=24
