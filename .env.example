# NAV Dokument-API — miljøvariabler (alle valgfrie)
# Kopier til .env og juster ved behov. Serveren kjører uten .env også.

# ═══ Sikkerhet ═══
# Settes denne, kreves headeren X-API-Key på alle endepunkter unntatt
# /hjelp. Tom = åpen (kun for lokal testing på et lukket nett).
API_NOKKEL=
# Kommaseparerte tillatte opphav for nettleserklienter. Tom = ingen
# CORS-header (mest restriktivt; vanlige klienter er ikke nettlesere).
CORS_ORIGINS=

# ═══ Server ═══
DOKUMENT_API_PORT=8600

# ═══ Modeller / stier ═══
MODELLER_STI=./modeller
FINJUSTERING_STI=./data/finjustering
GJENNOMGANG_STI=./data/gjennomgang

# ═══ Borealis (LLM) ═══
# Kontekstvindu. 8192 holder ~1 GiB VRAM fri til OCR på et 8 GB-kort (R51).
BOREALIS_KONTEKST=8192
MAKS_SVAR_TOKENS=1024

# ═══ OCR ═══
# auto = EasyOCR på GPU når det er plass, ellers RapidOCR på CPU (R51).
OCR_MOTOR=auto
OCR_MINSTE_LEDIG_GPU_MB=800
OCR_DPI=200
MAKS_NORHAND_PER_SIDE=12
MAKS_NORHAND_SEKUNDER=4.0

# ═══ Trening (Label Studio, kun for treningsløkken) ═══
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
