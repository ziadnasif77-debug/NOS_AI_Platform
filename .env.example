# NAV Dokument-API — miljøvariabler (alle valgfrie)
# Kopier til .env og juster ved behov. Serveren kjører uten .env også.

# ═══ Sikkerhet ═══
# Settes denne, kreves headeren X-API-Key på alt som bærer
# dokumentdata. ÅPNE er GET /hjelp (helsesjekk), GET /openapi.json og
# GET /dokumentasjon med /statisk/* — Swagger UI kjører i en nettleser
# og kan ikke sende headeren, så et krav der ville gjort
# dokumentasjonen ubrukelig. Ingen av dem returnerer dokumentinnhold.
# Tom = alt åpent (kun for lokal testing på et lukket nett).
API_NOKKEL=
# NAVNGITTE nøkler: «navn:nøkkel,navn:nøkkel». Virker SAMMEN med
# API_NOKKEL over — en klient som ennå ikke har byttet slipper inn med
# den gamle og får klient_id «eldre-nokkel» i loggen.
# Navnet blir klientens ID i tilgangsloggen, så la det si hvem det er
# («uipath-fakturamottak», ikke «nokkel1»). Nøkkelen logges aldri.
# Uten navngitte nøkler er hvert kall anonymt, og da kan ingen felter
# fjernes med kunnskap — se R91 og skript/klientrapport.py.
API_NOKLER=
# Kommaseparerte tillatte opphav for nettleserklienter. Tom = ingen
# CORS-header (mest restriktivt; vanlige klienter er ikke nettlesere).
CORS_ORIGINS=
# Rate-limiting: maks forespørsler per klient per minutt (dybdeforsvar på et
# eksponert endepunkt). Standard 120. Sett 0 for å skru av, eller høyere ved
# høy legitim last. GET /hjelp er unntatt (helsesjekk).
RATE_LIMIT_PER_MIN=120
# Tilgangsloggen roterer: maks MB per fil og antall arkiver som beholdes.
# Romslig med vilje — klientrapporten spør 30-365 dager tilbake, og en fil
# som roterer bort for tidlig gjør rapporten verdiløs (R101).
TILGANGSLOGG_MAKS_MB=10
TILGANGSLOGG_ARKIV=12
# Tilgangslogg: JSON-linje per forespørsel (metadata, aldri kroppen/PII).
# Standard data/logger/tilgang.log. Tom = av.
TILGANGSLOGG=data/logger/tilgang.log

# ═══ Server ═══
DOKUMENT_API_PORT=8600

# ═══ Modeller / stier ═══
MODELLER_STI=./modeller
FINJUSTERING_STI=./data/finjustering
GJENNOMGANG_STI=./data/gjennomgang
# Oppbevaringsvindu (dager) for gjennomgangsbilder — GDPR-hygiene på det
# eneste stedet data bevares. Ryddes av rydd_gjennomgang.py. Sett din egen
# governance-policy (§6.4).
OPPBEVARING_DAGER=30

# ═══ Borealis (LLM) ═══
# MERK (R190): kontekstvinduet settes nå AV MASKINEN naar du lar linja
# staa kommentert ut. Serveren maaler kortet og regner ut hva det taaler:
# paa et 8 GB-kort blir det 4096 — nøyaktig verdien under — og paa et
# stoerre kort blir det mer, uten at du roerer noe. Se profilen med
#   .pyruntime\python.exe -m delt.maskinprofil
# Setter du verdien her, vinner DIN verdi over maskinprofilen.
#
# 8192 SEGFAULTER på et 8 GB-kort sammen med OCR (KV-cachen blir for
# stor). 4096 er verifisert trygt der. Automatikken hever seg aldri over
# KONTEKST_AUTO_TAK av seg selv, nettopp fordi feilen ikke gir en
# feilmelding — den gir et nativt krasj uten traceback.
#BOREALIS_KONTEKST=4096
MAKS_SVAR_TOKENS=1024
# Hvilken GGUF som lastes. Uten denne tas den NYESTE .gguf-fila i
# modeller/borealis-gguf (mmproj-filer hoppes over). Bytt modell med
# skript/bytt_modell.py — det maaler foer og etter, og ruller tilbake
# hvis den nye ikke er maalbart bedre (R188/R189). AA bare kopiere inn
# en fil virker ogsaa, men da er du uten port og uten angreknapp.
#BOREALIS_GGUF=
# Antall lag paa GPU. -1 = alt. Senk (f.eks. 40) for aa dele en STOERRE
# modell mellom GPU og RAM paa et lite kort — tregere, men den kjoerer.
#BOREALIS_GPU_LAG=-1

# ═══ OCR ═══
# auto = EasyOCR på GPU når det er plass, ellers RapidOCR på CPU (R51).
OCR_MOTOR=auto
# Hvor mye LEDIG GPU-minne som kreves før OCR får bruke kortet.
# Sto 800 her — verdien som ble HEVET nettopp fordi den krasjet.
# Med Borealis residerende (~5,7 GB av 8) ga 800 MiB grønt lys til
# EasyOCR, og llama.cpp sine compute-buffere under neste inferens
# sprengte kortet: stille NATIV krasj, serveren bare døde uten
# traceback. Den som kopierte denne fila til en ny server startet
# altså med akkurat det oppsettet som feller tjenesten.
# Senk den ikke uten å måle på nytt (R140).
OCR_MINSTE_LEDIG_GPU_MB=2600
OCR_DPI=200
# Andel GODT LESTE dokumenter som likevel sendes til menneskelig
# gjennomgang, for aa kunne MAALE om terskelen over betyr noe
# (R149). AV som standard (0.0).
#
# Uten dette er kalibrering ikke vanskelig — den er UMULIG: bare
# dokumenter UNDER terskelen faar en menneskelig fasit, saa de
# oeverste boettene i kalibreringstabellen kan aldri fylles. Da
# maaler vi bare der vi allerede visste at det var daarlig, og
# treningsloekken laerer av feilene systemet visste om — aldri av
# dem det gjorde med selvtillit.
#
# 0.02 er nok til aa fylle tabellen over noen uker uten aa belaste
# noen merkbart. Det koster menneskelig tid, derfor er det et VALG.
KALIBRERING_ANDEL=0.0

# Terskelen som sender daarlig leste dokumenter til gjennomgang
# (konfidens under denne → Label Studio). Standard 0.85.
#LS_KONFIDENS_TERSKEL=0.85

# R187: nedre grense for MELLOMBAANDET. Dokumenter med konfidens i
# [GJENNOMGANG_NEDRE, LS_KONFIDENS_TERSKEL) holdes tilbake fra
# menneskelig gjennomgang HVIS den deterministiske andre-sjekken
# beviser at alt dokumenttypen forventer ble funnet
# (regler/dokumenttype_forventninger.txt). Standard = terskelen selv,
# altsaa et TOMT baand: dagens oppfoersel. IKKE senk denne foer
# kalibreringstabellen (R149) har vist hvor et baand er trygt — en
# umaalt terskel skal ikke faa en umaalt nabo. Tilbakehold logges som
# «mellomband_holdt_tilbake:<type>» i tilgangsloggen, saa baandet kan
# maales foer det utvides. Aktiverer du baandet, sett OGSAA
# KALIBRERING_ANDEL over 0: samme andel brukes til aa sende en liten
# proeve av de tilbakeholdbare (grunn «mellomband_kalibreringsproeve»)
# — uten den faar ingen tilbakeholdte dokumenter noensinne fasit, og
# baandet kan aldri etterproeves.
#GJENNOMGANG_NEDRE=0.85

MAKS_NORHAND_PER_SIDE=12
MAKS_NORHAND_SEKUNDER=4.0

# ═══ Trening (kun for treningsløkken — kjor_treningslop.py) ═══
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
# Kvalitetsport: fast valideringssett. Dommen faller på et
# KONFIDENSINTERVALL (bootstrap), ikke på en fast margin — på et lite
# sett er forskjellen mellom CER 0.041 og 0.043 støy, og en margin
# flytter bare terskelen for hvilken støy som slipper gjennom (R148).
# Overlapper intervallene til kandidat og live, kan modellene ikke
# skilles, og da promoteres ingenting.
VALIDERING_STI=./data/validering/norhand.json
