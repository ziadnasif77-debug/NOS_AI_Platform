# NAV Dokument-API — miljøvariabler (alle valgfrie)
# Kopier til .env og juster ved behov. Serveren kjører uten .env også.

# ═══ Sikkerhet ═══
# Settes denne, kreves headeren X-API-Key på alt som bærer
# dokumentdata. ÅPNE er GET /hjelp (helsesjekk), GET /openapi.json og
# GET /dokumentasjon med /statisk/* — Swagger UI kjører i en nettleser
# og kan ikke sende headeren, så et krav der ville gjort
# dokumentasjonen ubrukelig. Ingen av dem returnerer dokumentinnhold.
# Tom = alt åpent (kun for lokal testing på et lukket nett).
API_NOKKEL=
# NAVNGITTE nøkler: «navn:nøkkel,navn:nøkkel». Virker SAMMEN med
# API_NOKKEL over — en klient som ennå ikke har byttet slipper inn med
# den gamle og får klient_id «eldre-nokkel» i loggen.
# Navnet blir klientens ID i tilgangsloggen, så la det si hvem det er
# («uipath-fakturamottak», ikke «nokkel1»). Nøkkelen logges aldri.
# Uten navngitte nøkler er hvert kall anonymt, og da kan ingen felter
# fjernes med kunnskap — se R91 og skript/klientrapport.py.
API_NOKLER=
# Kommaseparerte tillatte opphav for nettleserklienter. Tom = ingen
# CORS-header (mest restriktivt; vanlige klienter er ikke nettlesere).
CORS_ORIGINS=
# Rate-limiting: maks forespørsler per klient per minutt (dybdeforsvar på et
# eksponert endepunkt). Standard 120. Sett 0 for å skru av, eller høyere ved
# høy legitim last. GET /hjelp er unntatt (helsesjekk).
RATE_LIMIT_PER_MIN=120
# Tilgangsloggen roterer: maks MB per fil og antall arkiver som beholdes.
# Romslig med vilje — klientrapporten spør 30-365 dager tilbake, og en fil
# som roterer bort for tidlig gjør rapporten verdiløs (R101).
TILGANGSLOGG_MAKS_MB=10
TILGANGSLOGG_ARKIV=12
# Tilgangslogg: JSON-linje per forespørsel (metadata, aldri kroppen/PII).
# Standard data/logger/tilgang.log. Tom = av.
TILGANGSLOGG=data/logger/tilgang.log

# ═══ Server ═══
DOKUMENT_API_PORT=8600

# ═══ Modeller / stier ═══
MODELLER_STI=./modeller
FINJUSTERING_STI=./data/finjustering
GJENNOMGANG_STI=./data/gjennomgang
# Oppbevaringsvindu (dager) for gjennomgangsbilder — GDPR-hygiene på det
# eneste stedet data bevares. Ryddes av rydd_gjennomgang.py. Sett din egen
# governance-policy (§6.4).
OPPBEVARING_DAGER=30

# ═══ Borealis (LLM) ═══
# Kontekstvindu. 8192 SEGFAULTER på et 8 GB-kort sammen med OCR (KV-cachen
# blir for stor). 4096 er verifisert trygt; øk bare hvis du frigjør GPU.
BOREALIS_KONTEKST=4096
MAKS_SVAR_TOKENS=1024

# ═══ OCR ═══
# auto = EasyOCR på GPU når det er plass, ellers RapidOCR på CPU (R51).
OCR_MOTOR=auto
# Hvor mye LEDIG GPU-minne som kreves før OCR får bruke kortet.
# Sto 800 her — verdien som ble HEVET nettopp fordi den krasjet.
# Med Borealis residerende (~5,7 GB av 8) ga 800 MiB grønt lys til
# EasyOCR, og llama.cpp sine compute-buffere under neste inferens
# sprengte kortet: stille NATIV krasj, serveren bare døde uten
# traceback. Den som kopierte denne fila til en ny server startet
# altså med akkurat det oppsettet som feller tjenesten.
# Senk den ikke uten å måle på nytt (R140).
OCR_MINSTE_LEDIG_GPU_MB=2600
OCR_DPI=200
MAKS_NORHAND_PER_SIDE=12
MAKS_NORHAND_SEKUNDER=4.0

# ═══ Trening (kun for treningsløkken — kjor_treningslop.py) ═══
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
# Kvalitetsport: fast valideringssett + hvor mye dårligere en kandidat
# kan være og fremdeles godtas (0.0 = må være minst like god som live).
VALIDERING_STI=./data/validering/norhand.json
CER_MARGIN=0.0
