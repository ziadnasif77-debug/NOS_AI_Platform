# Shell-skript MÅ ha LF — Windows' autocrlf=true konverterer ellers til
# CRLF ved checkout, som gir "invalid option" i bash (f.eks. `set -o pipefail`).
*.sh text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-batch og VBScript MÅ ha CRLF — cmd sin parser feiler på
# LF-bare linjer inne i parentesblokker ("'X' is not recognized ...").
*.bat text eol=crlf
*.vbs text eol=crlf
