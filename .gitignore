# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtuelle miljøer
.venv/
venv/
env/

# Miljøvariabler
.env

# Data og modeller (for store for git)
data/
# ...men lovtekstene SPORES (R174). De er offentlig rettskildetekst
# — ingen persondata — og til sammen 560 kB ren markdown. Uten dem
# hopper 24 tester over og 7 feiler på en frisk klone, mens de er
# grønne hos utvikleren: «1557 passed» var altså bare sant ett sted.
# En test som hopper over vokter ingenting.
!data/lover/
!data/lover/*.md
modeller/
# EasyOCR-vekter (craft 80 MB + latin_g2 15 MB) — samme policy som
# modeller/: modellvekter foelger den portable nav-mappa, ikke git.
.EasyOCR/

# Loggfiler
*.log
logs/

# Midlertidige filer
*.tmp
*.bak
tmp/

# Testdekning
.coverage
.coverage.*
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.claude/

# Lokale hemmeligheter for launcherne (Label Studio-token m.m.)
oppstart/lokal_env.bat

# Redis-dump fra lokal kjøring
dump.rdb
cloudflared.exe
data/jobber/
offline_pakke/
.venv-prefect/
# Python-pakker flyttet hit fra C (junction), + omdirigert cache (setx)
.python/
.cache/
.prefect/
.pyruntime/

# Locust for lasttesting (§21). 73 MB med kompilerte utvidelser —
# installeres med: .pyruntime\python.exe -m pip install --target last/pakker locust
last/pakker/
